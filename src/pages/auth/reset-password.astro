---
import MainLayout from "@/layouts/MainLayout.astro";
import ResetPasswordForm from "@/components/forms/ResetPasswordForm";
import LoginHeader from "@/components/LoginHeader.astro";

// Extraer el token de los parámetros de la URL
const token = Astro.url.searchParams.get("token");
---

<MainLayout title="Restablecer Contraseña">
  <LoginHeader />
  <main class="flex-1 flex items-center justify-center p-4 bg-slate-50">
    <div
      class="w-full max-w-md bg-white p-8 rounded-2xl shadow-lg border border-slate-100 flex flex-col items-center"
    >
      {
        !token ? (
          <div class="w-full">
            <div class="flex items-start gap-3 p-4 text-sm text-red-600 bg-red-50 rounded-lg border border-red-200 mb-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="flex-shrink-0 mt-0.5"
              >
                <circle cx="12" cy="12" r="10" />
                <line x1="12" x2="12" y1="8" y2="12" />
                <line x1="12" x2="12.01" y1="16" y2="16" />
              </svg>
              <div>
                <p class="font-semibold mb-1">Token no válido</p>
                <p>
                  No se proporcionó un token de recuperación válido. Por favor,
                  solicita un nuevo enlace de recuperación.
                </p>
              </div>
            </div>
            <div class="flex gap-3">
              <a
                href="/auth/forgot-password"
                class="flex-1 inline-flex items-center justify-center gap-2 font-semibold rounded-xl border border-transparent h-11 px-4 text-sm bg-primary text-white hover:bg-blue-700 transition-all"
              >
                Solicitar nuevo enlace
              </a>
              <a
                href="/login"
                class="flex-1 inline-flex items-center justify-center gap-2 font-semibold rounded-xl border border-slate-200 h-11 px-4 text-sm bg-white text-slate-900 hover:border-primary hover:text-primary hover:bg-blue-50 transition-all"
              >
                Volver al login
              </a>
            </div>
          </div>
        ) : (
          <>
            <div class="mb-6 text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-primary"
                >
                  <path d="M12 2a5 5 0 0 0-5 5v3H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-2V7a5 5 0 0 0-5-5z" />
                  <circle cx="12" cy="15" r="1" />
                </svg>
              </div>
              <h1 class="text-2xl font-bold text-slate-900 mb-2">
                Restablecer Contraseña
              </h1>
              <p class="text-slate-500">
                Ingresa tu nueva contraseña para actualizar tu cuenta.
              </p>
            </div>

            <ResetPasswordForm token={token} client:load />
          </>
        )
      }
    </div>
  </main>
</MainLayout>
