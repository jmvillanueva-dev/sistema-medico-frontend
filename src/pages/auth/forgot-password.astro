---
import MainLayout from "@/layouts/MainLayout.astro";
import ForgotPasswordForm from "@/components/forms/ForgotPasswordForm";
import LoginHeader from "@/components/LoginHeader.astro";
---

<MainLayout title="Recuperar Contraseña">
  <LoginHeader />
  <main class="flex-1 flex items-center justify-center p-4 bg-slate-50">
    <div
      class="w-full max-w-md bg-white p-8 rounded-2xl shadow-lg border border-slate-100 flex flex-col items-center"
    >
      <div class="mb-6 text-center">
        <div
          class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="32"
            height="32"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-primary"
          >
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-slate-900 mb-2">
          ¿Olvidaste tu contraseña?
        </h1>
        <p class="text-slate-500">
          Ingresa tu correo electrónico y te enviaremos instrucciones para
          restablecer tu contraseña.
        </p>
      </div>

      <ForgotPasswordForm client:load />
    </div>
  </main>
</MainLayout>
