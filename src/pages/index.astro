---
import MainLayout from "../layouts/MainLayout.astro";
import PublicHeader from "../components/PublicHeader.astro";

const systemDescription = "Sistema de Gestión de Historias Clínicas";
---

<MainLayout title="Inicio">
  <PublicHeader />
  <main class="flex-1 flex items-center justify-center text-center p-8 md:p-16">
    <div class="max-w-3xl flex flex-col gap-6">
      <h1 class="text-4xl md:text-6xl font-bold text-slate-900 leading-tight">
        Centro Médico <br /> Urdiales-Espinoza
      </h1>

      <h2
        class="text-xl md:text-3xl text-slate-600 font-normal opacity-90 mb-4"
      >
        {systemDescription}
      </h2>

      <div
        class="flex justify-center gap-6 mt-4 flex-col sm:flex-row items-center"
      >
        <a
          href="/tutorial-video"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold text-white bg-slate-800 rounded-xl transition-all hover:bg-slate-700 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 w-full sm:w-auto"
        >
          <img
            src="/icons/play.svg"
            class="w-6 h-6 brightness-0 invert"
            alt="Login icon"
          />
          Ver Video Tutorial
        </a>

        <a
          href="/login"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-semibold text-white bg-primary rounded-xl transition-all hover:bg-primary-600 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 w-full sm:w-auto"
        >
          <img
            src="/icons/medical.svg"
            class="w-6 h-6 brightness-0 invert"
            alt="Login icon"
          />
          Empezar Ahora
        </a>
      </div>
    </div>
  </main>
</MainLayout>
