---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import DailyEvolutionReport from "@/components/DailyEvolutionReport";
---

<DashboardLayout title="Dashboard Administrador">
  <div class="flex flex-col gap-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-900 mb-2">
        Panel de Administración
      </h1>
      <p class="text-slate-600">
        Resumen diario de evoluciones médicas registradas en el sistema
      </p>
    </div>

    <DailyEvolutionReport client:load />
  </div>
</DashboardLayout>
