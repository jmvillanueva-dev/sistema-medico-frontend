---
import MainLayout from "@/layouts/MainLayout.astro";
import ForcePasswordChangeForm from "@/components/forms/ForcePasswordChangeForm";
import LoginHeader from "@/components/LoginHeader.astro";

// Extraer el email de los parámetros de la URL
const email = Astro.url.searchParams.get("email");
---

<MainLayout title="Cambio de Contraseña Obligatorio">
  <LoginHeader />
  <main class="flex-1 flex items-center justify-center p-4 bg-slate-50">
    <div
      class="w-full max-w-md bg-white p-8 rounded-2xl shadow-lg border border-slate-100 flex flex-col items-center"
    >
      {
        !email ? (
          <div class="w-full">
            <div class="flex items-start gap-3 p-4 text-sm text-red-600 bg-red-50 rounded-lg border border-red-200 mb-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="flex-shrink-0 mt-0.5"
              >
                <circle cx="12" cy="12" r="10" />
                <line x1="12" x2="12" y1="8" y2="12" />
                <line x1="12" x2="12.01" y1="16" y2="16" />
              </svg>
              <div>
                <p class="font-semibold mb-1">Acceso no válido</p>
                <p>
                  No se proporcionó información de usuario válida. Por favor,
                  inicia sesión para continuar.
                </p>
              </div>
            </div>
            <a
              href="/login"
              class="w-full inline-flex items-center justify-center gap-2 font-semibold rounded-xl border border-transparent h-11 px-4 text-sm bg-primary text-white hover:bg-blue-700 transition-all"
            >
              Ir al inicio de sesión
            </a>
          </div>
        ) : (
          <>
            <div class="mb-6 text-center">
              <div class="inline-flex items-center justify-center w-16 h-16 bg-amber-100 rounded-full mb-4">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="32"
                  height="32"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="text-amber-600"
                >
                  <path d="M12 2a5 5 0 0 0-5 5v3H5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2h-2V7a5 5 0 0 0-5-5z" />
                  <circle cx="12" cy="15" r="1" />
                </svg>
              </div>
              <h1 class="text-2xl font-bold text-slate-900 mb-2">
                Cambio de Contraseña Obligatorio
              </h1>
              <p class="text-slate-500">
                Por seguridad, debes cambiar tu contraseña temporal antes de
                continuar usando el sistema.
              </p>
            </div>

            <ForcePasswordChangeForm email={email} client:load />
          </>
        )
      }
    </div>
  </main>
</MainLayout>
