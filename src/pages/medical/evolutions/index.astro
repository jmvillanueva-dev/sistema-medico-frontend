---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import MedicalEvolutionHistory from "../../../components/MedicalEvolution/MedicalEvolutionHistory";

// Get URL parameters
const url = new URL(Astro.request.url);
const historiaClinicaId = url.searchParams.get("historiaClinicaId");
---

<DashboardLayout title="Evoluciones Médicas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <MedicalEvolutionHistory
      client:load
      historiaClinicaId={historiaClinicaId || undefined}
    />
  </div>
</DashboardLayout>
