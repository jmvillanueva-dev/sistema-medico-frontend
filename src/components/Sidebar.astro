---
const { url } = Astro;
const { role = "admin", roles = [] } = Astro.props;
import { SidebarFooter } from "@/components/SidebarFooter";

// Definir tipos para TypeScript
interface MenuItemBase {
  name: string;
  icon: string; // Ruta al icono SVG
}

interface MenuItemWithHref extends MenuItemBase {
  href: string;
  subItems?: never;
}

interface MenuItemWithSubItems extends MenuItemBase {
  href?: never;
  subItems: {
    name: string;
    href: string;
  }[];
}

type MenuItem = MenuItemWithHref | MenuItemWithSubItems;

const allMenuItems: MenuItem[] = [
  {
    name: "Dashboard",
    href: "/admin/dashboard",
    icon: "/src/icons/system/dashboard.svg",
  },
  {
    name: "Empleados",
    icon: "/src/icons/system/users-group.svg",
    subItems: [
      {
        name: "Lista de Empleados",
        href: "/admin/employees",
      },
      {
        name: "Gestión de Roles",
        href: "/admin/roles",
      },
    ],
  },
  {
    name: "Pacientes",
    href: "/admin/patients",
    icon: "/src/icons/system/hospital.svg",
  },
  {
    name: "Historias Clínicas",
    href: "/admin/clinical-records",
    icon: "/src/icons/system/clipboard.svg",
  },
  {
    name: "Evoluciones Médicas",
    href: "/admin/evolutions",
    icon: "/src/icons/system/file-text.svg",
  },
];

// Filtrar items basado en el rol
const menuItems = allMenuItems
  .filter((item) => {
    if (role === "admin") return true; // Admin ve todo

    if (role === "medical") {
      // Personal médico solo ve Dashboard (médico), Pacientes e Historias Clínicas
      // Nota: El dashboard médico tiene una ruta diferente, la ajustamos aquí si es necesario
      if (item.name === "Dashboard") {
        // Ajustamos el href para el dashboard médico dinámicamente o lo manejamos en la redirección
        // Por ahora, asumimos que el link del sidebar lleva al dashboard correspondiente
        // Pero como el array es estático, mejor creamos una copia modificada si es necesario
        return true;
      }
      return ["Pacientes", "Historias Clínicas", "Evoluciones Médicas"].includes(item.name);
    }

    return false;
  })
  .map((item) => {
    // Ajuste específico para el link del dashboard si es médico
    if (role === "medical") {
      if (item.name === "Dashboard") {
        return { ...item, href: "/medical/dashboard" };
      }
      if (item.name === "Pacientes") {
        return { ...item, href: "/medical/patients" };
      }
      if (item.name === "Historias Clínicas") {
        return { ...item, href: "/medical/clinical-records" };
      }
      if (item.name === "Evoluciones Médicas") {
        return { ...item, href: "/medical/evolutions" };
      }
    }
    return item;
  });

// Función para determinar si un item está activo
const isItemActive = (item: { href?: string }): boolean => {
  if (item.href) {
    return (
      url.pathname === item.href || url.pathname.startsWith(item.href + "/")
    );
  }
  return false;
};

const isSubItemActive = (subItems: { href: string }[]): boolean => {
  return subItems.some((subItem) => isItemActive(subItem));
};

// Función helper para generar IDs seguros
const generateId = (name: string): string => {
  return `submenu-${name.toLowerCase().replace(/\s+/g, "-")}`;
};
---

<aside
  class="w-[260px] bg-white rounded-2xl border-r border-slate-200 flex flex-col m-3 p-6 sticky top-3 h-[calc(100vh-24px)] overflow-y-auto shadow-sm z-10 transition-all duration-300 group"
  id="sidebar"
>
  <div
    class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100 transition-all duration-300 group-[.collapsed]:flex-col group-[.collapsed]:gap-2 group-[.collapsed]:items-center"
  >
    <div
      class="flex items-center gap-3 text-slate-900 font-bold text-lg hover:text-primary transition-colors cursor-pointer lg:group-[.collapsed]:hidden"
      id="headerToggle"
    >
      <img
        src="/src/icons/system/menu.svg"
        alt="Menu Icon"
        class="w-7 h-7 shrink-0"
      />
      <span
        class="whitespace-nowrap transition-all duration-200 lg:group-[.collapsed]:opacity-0 lg:group-[.collapsed]:w-0 lg:group-[.collapsed]:hidden"
        >MENU</span
      >
    </div>

    <!-- Botón para colapsar/expandir (Solo Desktop) -->
    <button
      type="button"
      class="hidden lg:flex items-center justify-center w-8 h-8 p-0 bg-slate-50 border border-slate-200 rounded-lg cursor-pointer shrink-0 transition-all hover:bg-primary-50 hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-primary"
      id="sidebarToggle"
      aria-label="Colapsar menú"
      title="Colapsar menú"
    >
      <img
        src="/src/icons/system/chevron-left.svg"
        alt=""
        class="w-4 h-4 transition-transform duration-300 group-[.collapsed]:rotate-180"
        aria-hidden="true"
      />
    </button>

    <!-- Botón para cerrar menú (Solo Móvil) -->
    <button
      type="button"
      class="flex lg:hidden items-center justify-center w-8 h-8 p-0 bg-slate-50 border border-slate-200 rounded-lg cursor-pointer shrink-0 transition-all hover:bg-red-50 hover:border-red-200 hover:text-red-500"
      id="mobileCloseSidebar"
      aria-label="Cerrar menú"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <nav class="flex-1">
    <ul class="flex flex-col gap-1 list-none p-0 m-0">
      {
        menuItems.map((item) => {
          const hasSubItems =
            "subItems" in item && item.subItems && item.subItems.length > 0;
          const isActive = hasSubItems
            ? isSubItemActive(item.subItems)
            : isItemActive(item);
          const isParentActive = hasSubItems && isSubItemActive(item.subItems);

          if (hasSubItems && item.subItems) {
            const submenuId = generateId(item.name);

            return (
              <li
                class:list={[
                  "relative",
                  "has-submenu",
                  { open: isParentActive },
                ]}
              >
                <button
                  type="button"
                  class:list={[
                    "flex items-center gap-3 w-full px-4 py-3 rounded-lg font-medium text-sm transition-all border-none cursor-pointer text-left lg:group-[.collapsed]:justify-center lg:group-[.collapsed]:px-2 submenu-toggle",
                    isParentActive
                      ? "bg-primary text-white hover:bg-primary-600 hover:text-white"
                      : "bg-transparent text-slate-500 hover:bg-primary-50 hover:text-primary",
                  ]}
                  data-submenu={submenuId}
                  title={item.name}
                >
                  <img
                    src={item.icon}
                    alt=""
                    class:list={[
                      "w-5 h-5 shrink-0 transition-all",
                      { "brightness-0 invert": isParentActive },
                    ]}
                    aria-hidden="true"
                  />
                  <span class="flex-1 whitespace-nowrap overflow-hidden text-ellipsis transition-all duration-200 lg:group-[.collapsed]:opacity-0 lg:group-[.collapsed]:w-0 lg:group-[.collapsed]:overflow-hidden">
                    {item.name}
                  </span>
                  <span
                    class:list={[
                      "w-2 h-2 border-r-2 border-b-2 border-current transform rotate-45 transition-all duration-200 lg:group-[.collapsed]:hidden",
                      { "rotate-[225deg] -translate-y-1": isParentActive },
                    ]}
                  />
                  <!-- Tooltip -->
                  <div class="fixed left-[70px] px-2 py-1 bg-slate-800 text-white text-xs rounded opacity-0 invisible transition-all duration-200 lg:group-[.collapsed]:group-hover/btn:opacity-100 lg:group-[.collapsed]:group-hover/btn:visible z-[1300] pointer-events-none whitespace-nowrap">
                    {item.name}
                  </div>
                </button>
                <ul
                  id={submenuId}
                  class="list-none p-0 m-0 max-h-0 overflow-hidden transition-all duration-300 lg:group-[.collapsed]:hidden submenu"
                >
                  {item.subItems.map((subItem) => {
                    const isChildActive = isItemActive(subItem);
                    return (
                      <li class="my-1">
                        <a
                          href={subItem.href}
                          class:list={[
                            "flex items-center gap-2 pl-10 pr-4 py-2 rounded-lg text-slate-500 no-underline text-sm transition-all hover:bg-primary-50 hover:text-primary group/link relative",
                            {
                              "text-primary font-semibold bg-primary-50":
                                isChildActive,
                            },
                          ]}
                          data-nav-item
                        >
                          <span
                            class:list={[
                              "text-slate-400 text-base leading-none transition-colors shrink-0",
                              { "text-primary": isChildActive },
                            ]}
                          >
                            •
                          </span>
                          <span class="whitespace-nowrap overflow-hidden text-ellipsis">
                            {subItem.name}
                          </span>
                          <!-- Tooltip for submenu items (optional, but good for consistency if text is truncated) -->
                          <div class="fixed left-[260px] px-2 py-1 bg-slate-800 text-white text-xs rounded opacity-0 invisible transition-all duration-200 group-hover/link:opacity-100 group-hover/link:visible z-[1300] pointer-events-none whitespace-nowrap lg:hidden">
                            {subItem.name}
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          } else if ("href" in item) {
            return (
              <li class="relative">
                <a
                  href={item.href}
                  class:list={[
                    "flex items-center gap-3 w-full px-4 py-3 rounded-lg text-slate-500 font-medium text-sm transition-all no-underline hover:bg-primary-50 hover:text-primary lg:group-[.collapsed]:justify-center lg:group-[.collapsed]:px-2 group/link relative",
                    {
                      "bg-primary text-white hover:bg-primary-600 hover:text-white font-semibold":
                        isActive,
                    },
                  ]}
                  data-nav-item
                  title={item.name}
                >
                  <img
                    src={item.icon}
                    alt=""
                    class:list={[
                      "w-5 h-5 shrink-0 transition-all",
                      { "brightness-0 invert": isActive },
                    ]}
                    aria-hidden="true"
                  />
                  <span class="whitespace-nowrap overflow-hidden text-ellipsis transition-all duration-200 lg:group-[.collapsed]:opacity-0 lg:group-[.collapsed]:w-0 lg:group-[.collapsed]:hidden">
                    {item.name}
                  </span>
                  <!-- Tooltip -->
                  <div class="fixed left-[70px] px-2 py-1 bg-slate-800 text-white text-xs rounded opacity-0 invisible transition-all duration-200 lg:group-[.collapsed]:group-hover/link:opacity-100 lg:group-[.collapsed]:group-hover/link:visible z-[1300] pointer-events-none whitespace-nowrap">
                    {item.name}
                  </div>
                </a>
              </li>
            );
          }

          return null;
        })
      }
    </ul>
  </nav>

  <SidebarFooter client:visible roles={roles} />
</aside>

<style>
  /* Custom scrollbar for sidebar */
  aside::-webkit-scrollbar {
    width: 6px;
  }
  aside::-webkit-scrollbar-track {
    background: transparent;
  }
  aside::-webkit-scrollbar-thumb {
    background-color: #e2e8f0;
    border-radius: 9999px;
  }
  aside::-webkit-scrollbar-thumb:hover {
    background-color: #94a3b8;
  }

  /* Collapsed state overrides - ONLY DESKTOP */
  @media (min-width: 1024px) {
    aside.collapsed {
      width: 72px;
      padding: 1rem 0.5rem;
    }
  }

  /* Submenu open state */
  .has-submenu.open > .submenu {
    max-height: 500px;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sidebar = document.getElementById("sidebar");
    const toggleBtn = document.getElementById("sidebarToggle");
    const headerToggle = document.getElementById("headerToggle");
    const mobileCloseBtn = document.getElementById("mobileCloseSidebar");
    const COLLAPSED_KEY = "sidebar-collapsed";

    // Función para alternar sidebar
    function toggleSidebar() {
        if (!sidebar) return;
        sidebar.classList.toggle("collapsed");
        const nowCollapsed = sidebar.classList.contains("collapsed");
        localStorage.setItem(COLLAPSED_KEY, String(nowCollapsed));

        // Actualizar aria-label del botón
        if (toggleBtn) {
            const label = nowCollapsed ? "Expandir menú" : "Colapsar menú";
            toggleBtn.setAttribute("aria-label", label);
            toggleBtn.setAttribute("title", label);
        }
    }

    // Restaurar estado colapsado desde localStorage (Solo si es desktop)
    const isCollapsed = localStorage.getItem(COLLAPSED_KEY) === "true";
    if (isCollapsed && sidebar && window.innerWidth >= 1024) {
      sidebar.classList.add("collapsed");
    }

    // Manejar clic en botón de colapsar (Desktop)
    if (toggleBtn) {
      toggleBtn.addEventListener("click", toggleSidebar);
    }

    // Manejar clic en el header "MENU"
    if (headerToggle) {
        headerToggle.addEventListener("click", toggleSidebar);
    }

    // Manejar clic en botón de cerrar (Móvil)
    if (mobileCloseBtn) {
      mobileCloseBtn.addEventListener("click", function () {
        // Disparar evento personalizado para que DashboardLayout lo capture
        const event = new CustomEvent("closeMobileSidebar", { bubbles: true });
        mobileCloseBtn.dispatchEvent(event);

        // Fallback directo por si acaso
        const sidebarContainer = document.getElementById("sidebarContainer");
        const overlay = document.getElementById("sidebarOverlay");
        const toggleBtn = document.getElementById("mobileMenuToggle");

        if (sidebarContainer)
          sidebarContainer.classList.add("-translate-x-full");
        if (overlay) overlay.classList.remove("active");
        if (toggleBtn) toggleBtn.classList.remove("active");
      });
    }
    // Manejar clic en botones de submenú
    document.querySelectorAll(".submenu-toggle").forEach((button) => {
      button.addEventListener("click", function (this: HTMLElement, e: Event) {
        e.preventDefault();
        e.stopPropagation();

        const parentLi = this.closest(".has-submenu");
        const submenuId = this.getAttribute("data-submenu");
        if (!submenuId || !parentLi) return;

        // AUTO-EXPAND LOGIC:
        // Si el sidebar está colapsado y se hace clic en un submenú, expandirlo primero
        if (sidebar && sidebar.classList.contains("collapsed")) {
            toggleSidebar(); // Use the shared toggle function
        }

        const submenu = document.getElementById(
          submenuId,
        ) as HTMLElement | null;
        if (!submenu) return;

        // Cerrar otros submenús abiertos
        document.querySelectorAll(".has-submenu.open").forEach((openLi) => {
          if (openLi !== parentLi) {
            openLi.classList.remove("open");
            // Also remove active class from toggle button
            const toggle = openLi.querySelector(".submenu-toggle");
            if (toggle) {
              toggle.classList.remove("bg-primary", "text-white");
              const icon = toggle.querySelector("img");
              if (icon) icon.classList.remove("brightness-0", "invert");
            }
          }
        });

        // Alternar el submenú actual
        parentLi.classList.toggle("open");
      });
    });
  });
</script>
