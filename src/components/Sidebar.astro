---
import "./Sidebar.css";

const { url } = Astro;

// Definir tipos para TypeScript
interface MenuItemBase {
  name: string;
  icon: string; // Ruta al icono SVG
}

interface MenuItemWithHref extends MenuItemBase {
  href: string;
  subItems?: never;
}

interface MenuItemWithSubItems extends MenuItemBase {
  href?: never;
  subItems: {
    name: string;
    href: string;
  }[];
}

type MenuItem = MenuItemWithHref | MenuItemWithSubItems;

const menuItems: MenuItem[] = [
  {
    name: "Dashboard",
    href: "/admin/dashboard",
    icon: "/src/icons/system/dashboard.svg",
  },
  {
    name: "Empleados",
    icon: "/src/icons/system/users-group.svg",
    subItems: [
      {
        name: "Lista de Empleados",
        href: "/admin/employees",
      },
      {
        name: "Gestión de Roles",
        href: "/admin/roles",
      },
    ],
  },
  {
    name: "Usuarios",
    href: "/admin/users",
    icon: "/src/icons/system/user-single.svg",
  },
  {
    name: "Pacientes",
    href: "/admin/patients",
    icon: "/src/icons/system/hospital.svg",
  },
  {
    name: "Historias Clínicas",
    href: "/admin/clinical-records",
    icon: "/src/icons/system/clipboard.svg",
  },
];

// Función para determinar si un item está activo
const isItemActive = (item: { href?: string }): boolean => {
  if (item.href) {
    return (
      url.pathname === item.href || url.pathname.startsWith(item.href + "/")
    );
  }
  return false;
};

const isSubItemActive = (subItems: { href: string }[]): boolean => {
  return subItems.some((subItem) => isItemActive(subItem));
};

// Función helper para generar IDs seguros
const generateId = (name: string): string => {
  return `submenu-${name.toLowerCase().replace(/\s+/g, "-")}`;
};
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a href="/admin/dashboard" class="sidebar-brand">
      <img
        src="/src/icons/system/menu.svg"
        alt="Menu Icon"
        class="sidebar-logo"
      />
      <span class="sidebar-title">MENU</span>
    </a>
    <!-- Botón para colapsar/expandir -->
    <button
      type="button"
      class="sidebar-toggle"
      id="sidebarToggle"
      aria-label="Colapsar menú"
      title="Colapsar menú"
    >
      <img
        src="/src/icons/system/chevron-left.svg"
        alt=""
        class="toggle-icon"
        aria-hidden="true"
      />
    </button>
  </div>

  <nav class="sidebar-nav">
    <ul class="nav-list">
      {
        menuItems.map((item) => {
          const hasSubItems =
            "subItems" in item && item.subItems && item.subItems.length > 0;
          const isActive = hasSubItems
            ? isSubItemActive(item.subItems)
            : isItemActive(item);
          const isParentActive = hasSubItems && isSubItemActive(item.subItems);

          if (hasSubItems && item.subItems) {
            const submenuId = generateId(item.name);

            return (
              <li
                class:list={[
                  "nav-item",
                  "has-submenu",
                  { open: isParentActive },
                ]}
              >
                <button
                  type="button"
                  class:list={[
                    "nav-link",
                    "submenu-toggle",
                    { active: isParentActive },
                  ]}
                  data-submenu={submenuId}
                  title={item.name}
                >
                  <img
                    src={item.icon}
                    alt=""
                    class="nav-icon"
                    aria-hidden="true"
                  />
                  <span class="nav-text">{item.name}</span>
                  <span class="arrow" />
                </button>
                <ul id={submenuId} class="submenu">
                  {item.subItems.map((subItem) => {
                    const isChildActive = isItemActive(subItem);
                    return (
                      <li class="submenu-item">
                        <a
                          href={subItem.href}
                          class:list={[
                            "submenu-link",
                            { active: isChildActive },
                          ]}
                          data-nav-item
                        >
                          <span class="submenu-bullet">•</span>
                          <span class="submenu-text">{subItem.name}</span>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          } else if ("href" in item) {
            return (
              <li class="nav-item">
                <a
                  href={item.href}
                  class:list={["nav-link", { active: isActive }]}
                  data-nav-item
                  title={item.name}
                >
                  <img
                    src={item.icon}
                    alt=""
                    class="nav-icon"
                    aria-hidden="true"
                  />
                  <span class="nav-text">{item.name}</span>
                </a>
              </li>
            );
          }

          return null;
        })
      }
    </ul>
  </nav>
</aside>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const sidebar = document.getElementById("sidebar");
    const toggleBtn = document.getElementById("sidebarToggle");
    const COLLAPSED_KEY = "sidebar-collapsed";

    // Restaurar estado colapsado desde localStorage
    const isCollapsed = localStorage.getItem(COLLAPSED_KEY) === "true";
    if (isCollapsed && sidebar) {
      sidebar.classList.add("collapsed");
    }

    // Manejar clic en botón de colapsar
    if (toggleBtn && sidebar) {
      toggleBtn.addEventListener("click", function () {
        sidebar.classList.toggle("collapsed");
        const nowCollapsed = sidebar.classList.contains("collapsed");
        localStorage.setItem(COLLAPSED_KEY, String(nowCollapsed));

        // Actualizar aria-label del botón
        const label = nowCollapsed ? "Expandir menú" : "Colapsar menú";
        toggleBtn.setAttribute("aria-label", label);
        toggleBtn.setAttribute("title", label);
      });
    }

    // Manejar clic en botones de submenú
    document.querySelectorAll(".submenu-toggle").forEach((button) => {
      button.addEventListener("click", function (this: HTMLElement, e: Event) {
        e.preventDefault();
        e.stopPropagation();

        const parentLi = this.closest(".has-submenu");
        const submenuId = this.getAttribute("data-submenu");
        if (!submenuId || !parentLi) return;

        const submenu = document.getElementById(
          submenuId
        ) as HTMLElement | null;
        if (!submenu) return;

        // Cerrar otros submenús abiertos
        document.querySelectorAll(".has-submenu.open").forEach((openLi) => {
          if (openLi !== parentLi) {
            openLi.classList.remove("open");
            const otherSubmenu = openLi.querySelector(
              ".submenu"
            ) as HTMLElement | null;
            if (otherSubmenu) {
              otherSubmenu.style.maxHeight = "0";
            }
          }
        });

        // Alternar el submenú actual
        const isOpening = !parentLi.classList.contains("open");
        parentLi.classList.toggle("open");

        if (isOpening) {
          submenu.style.maxHeight = submenu.scrollHeight + "px";
        } else {
          submenu.style.maxHeight = "0";
        }
      });
    });

    // Manejar clic en enlaces de navegación
    document.querySelectorAll("[data-nav-item]").forEach((link) => {
      link.addEventListener("click", function (this: HTMLElement, e: Event) {
        // No cerrar el submenú al hacer clic en un subitem
        e.stopPropagation();

        // Actualizar estado activo visualmente
        document.querySelectorAll("[data-nav-item]").forEach((item) => {
          item.classList.remove("active");
        });
        this.classList.add("active");

        // Marcar el padre como activo si es un subitem
        const submenuItem = this.closest(".submenu-item");
        if (submenuItem) {
          const parentLi = submenuItem.closest(".has-submenu");
          if (parentLi) {
            parentLi.classList.add("open");
            const submenu = parentLi.querySelector(
              ".submenu"
            ) as HTMLElement | null;
            if (submenu) {
              submenu.style.maxHeight = submenu.scrollHeight + "px";
            }
          }
        }
      });
    });

    // Cerrar submenús al hacer clic fuera del sidebar
    document.addEventListener("click", function (e: MouseEvent) {
      const target = e.target as HTMLElement | null;
      if (target && !target.closest(".sidebar")) {
        document.querySelectorAll(".has-submenu.open").forEach((openLi) => {
          openLi.classList.remove("open");
          const submenu = openLi.querySelector(
            ".submenu"
          ) as HTMLElement | null;
          if (submenu) {
            submenu.style.maxHeight = "0";
          }
        });
      }
    });

    // Inicializar submenús abiertos si corresponden a la página actual
    document.querySelectorAll(".has-submenu").forEach((item) => {
      const activeSubItem = item.querySelector(".submenu-link.active");
      if (activeSubItem) {
        item.classList.add("open");
        const submenu = item.querySelector(".submenu") as HTMLElement | null;
        if (submenu) {
          submenu.style.maxHeight = submenu.scrollHeight + "px";
        }
      }
    });
  });
</script>
