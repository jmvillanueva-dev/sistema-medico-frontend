---
import DashboardHeader from "../components/DashboardHeader.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface Props {
  title: string;
  role?: "admin" | "medical";
}

const { title, role = "admin" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Administración del Sistema" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 overflow-hidden">
    <div class="flex h-screen w-full">
      <!-- Mobile Menu Toggle -->
      <button
        class="fixed top-4 left-4 z-[1100] w-11 h-11 p-2 bg-white border border-slate-200 rounded-lg cursor-pointer flex flex-col justify-center items-center gap-[5px] shadow-md transition-all lg:hidden group"
        id="mobileMenuToggle"
        aria-label="Abrir menú"
      >
        <span
          class="w-5 h-0.5 bg-slate-900 rounded-sm transition-all group-[.active]:rotate-45 group-[.active]:translate-x-[5px] group-[.active]:translate-y-[5px]"
        ></span>
        <span
          class="w-5 h-0.5 bg-slate-900 rounded-sm transition-all group-[.active]:opacity-0"
        ></span>
        <span
          class="w-5 h-0.5 bg-slate-900 rounded-sm transition-all group-[.active]:-rotate-45 group-[.active]:translate-x-[5px] group-[.active]:-translate-y-[5px]"
        ></span>
      </button>

      <!-- Overlay para móvil -->
      <div
        class="fixed inset-0 bg-black/50 z-[999] opacity-0 pointer-events-none transition-opacity duration-300 [&.active]:opacity-100 [&.active]:pointer-events-auto lg:hidden"
        id="sidebarOverlay"
      >
      </div>

      <!-- Sidebar Container -->
      <div
        id="sidebarContainer"
        class="h-full flex-shrink-0 transition-all duration-300 ease-in-out fixed inset-y-0 left-0 z-[1200] w-[260px] -translate-x-full lg:translate-x-0 lg:relative lg:w-auto"
      >
        <Sidebar role={role} />
      </div>

      <!-- Main Content -->
      <main
        class="flex-1 flex flex-col min-w-0 h-full overflow-hidden transition-all duration-300"
      >
        <DashboardHeader />
        <div
          class="flex-1 overflow-y-auto p-6 lg:p-4 sm:p-3 pt-4 lg:pt-[calc(0.75rem+60px)] sm:pt-[calc(0.5rem+60px)]"
        >
          <div
            class="bg-white rounded-xl shadow-sm min-h-full p-6 lg:p-4 sm:p-3"
          >
            <slot />
          </div>
          <div class="mt-6">
            <Footer />
          </div>
        </div>
      </main>
    </div>

    <script>
      // Manejo del menú móvil
      document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById("mobileMenuToggle");
        const overlay = document.getElementById("sidebarOverlay");
        const sidebarContainer = document.getElementById("sidebarContainer");

        // Función para abrir sidebar móvil
        function openMobileSidebar() {
          sidebarContainer?.classList.remove("-translate-x-full");
          overlay?.classList.add("active");
          toggleBtn?.classList.add("active");
        }

        // Función para cerrar sidebar móvil
        function closeMobileSidebar() {
          sidebarContainer?.classList.add("-translate-x-full");
          overlay?.classList.remove("active");
          toggleBtn?.classList.remove("active");
        }

        // Toggle menú móvil
        toggleBtn?.addEventListener("click", () => {
          if (toggleBtn.classList.contains("active")) {
            closeMobileSidebar();
          } else {
            openMobileSidebar();
          }
        });

        overlay?.addEventListener("click", closeMobileSidebar);

        // Resetear estado al cambiar tamaño de ventana
        window.addEventListener("resize", () => {
          if (window.innerWidth >= 1024) {
            closeMobileSidebar(); // Asegura limpieza de clases móviles
          }
        });

        // Escuchar evento de cierre desde el Sidebar
        document.addEventListener("closeMobileSidebar", () => {
          closeMobileSidebar();
        });
      });
    </script>
  </body>
</html>
