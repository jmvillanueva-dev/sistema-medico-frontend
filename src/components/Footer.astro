---
const currentYear = new Date().getFullYear();
const developer = "jmvillanueva";
---

<footer
  class="flex flex-wrap justify-center items-center gap-2 w-full shrink-0 px-6 py-4 text-slate-500 text-center text-sm bg-transparent md:flex-row flex-col"
>
  <span class="leading-relaxed">
    <p>&copy; {currentYear} Derechos Reservados</p>
  </span>
  <span
    class="inline-flex items-center gap-1 text-inherit no-underline transition-colors hover:text-primary"
  >
    <a
      href="https://github.com/jmvillanueva-dev"
      class="inline-flex items-center gap-1 text-inherit no-underline transition-colors hover:text-primary"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="hidden md:inline">|</span> Desarrollado por
      <img src="/src/icons/social-media/github.svg" alt="" class="w-4 h-auto" />
      <strong class="hover:underline">{developer}</strong>
      <span class="hidden md:inline">|</span>
    </a>
  </span>
  <span class="inline-flex items-center gap-1">
    <img
      src="/src/icons/ecuador.svg"
      alt="Bandera Ecuador"
      class="w-5 h-auto"
    />
    Hecho en Ecuador
  </span>
</footer>
