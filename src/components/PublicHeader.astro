---
import { getDashboardPath } from "@/utils/navigation";

const logoName = "Urdiales-Espinoza";

// Leer la cookie de autenticación en el servidor
const userCookie = Astro.cookies.get("auth-user")?.value;
let user = null;
let dashboardPath = "/login";

if (userCookie) {
  try {
    user = JSON.parse(userCookie);
    dashboardPath = getDashboardPath(user.roles);
  } catch (e) {
    user = null;
  }
}

const isAuthenticated = !!user;
---

<header
  class="w-full sticky top-0 z-[1000] bg-white/80 backdrop-blur-md border-b border-slate-200"
>
  <nav
    class="flex justify-between items-center max-w-7xl mx-auto px-4 py-3 sm:px-6 sm:py-4"
  >
    <a
      href="/"
      class="flex items-center gap-2 text-primary no-underline drop-shadow-sm transition-transform hover:scale-[1.02]"
    >
      <img
        src="/logo-cm-ue.svg"
        alt="Logo Centro Médico Urdiales-Espinoza"
        height="40"
        class="h-9 sm:h-10 w-auto"
      />
      <!-- Logo text hidden on mobile, shown on md screens and up -->
      <div class="hidden md:flex flex-col leading-tight">
        <span class="font-normal text-lg tracking-wide"
          >{logoName.toUpperCase()}</span
        >
        <span
          class="text-slate-900 font-light text-sm text-center tracking-widest"
          >CENTRO MÉDICO</span
        >
      </div>
    </a>

    <div class="flex gap-3">
      <a
        href="/login"
        class="inline-flex items-center gap-2 px-4 py-2.5 sm:px-6 sm:py-3 text-sm font-medium text-white bg-primary rounded-xl transition-all hover:bg-primary-600 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 group"
      >
        <img
          src="/icons/login.svg"
          class="w-5 h-5 brightness-0 invert"
          alt="Login icon"
        />
        <!-- Short text on mobile, full text on sm screens and up -->
        <span class="sm:hidden">Acceder</span>
        <span class="hidden sm:inline">Iniciar Sesión</span>
        <img
          src="/icons/arrow-right.svg"
          class="w-4 h-4 brightness-0 invert transition-transform group-hover:translate-x-1"
          alt="Arrow icon"
        />
      </a>
    </div>
  </nav>
</header>
