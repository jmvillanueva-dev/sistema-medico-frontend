---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import MedicalEvolutionHistory from "../../../../components/MedicalEvolution/MedicalEvolutionHistory";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/admin/evolutions");
}
---

<DashboardLayout title="Historial de Evoluciones (Admin)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <MedicalEvolutionHistory
      client:load
      historiaClinicaId={id}
      isAdmin={true}
      onViewDetail={(evolutionId) => {
        window.location.href = `/admin/evolutions/${evolutionId}`;
      }}
      onEdit={(evolutionId) => {
        window.location.href = `/admin/evolutions/edit/${evolutionId}`;
      }}
      onCreate={() => {
        window.location.href = `/admin/evolutions/create/${id}`;
      }}
    />
  </div>
</DashboardLayout>
