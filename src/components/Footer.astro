---
const currentYear = new Date().getFullYear();
const developer = "jmvillanueva";
---

<footer class="main-footer">
  <span class="footer-copyright">
    <p>&copy; {currentYear} Derechos Reservados</p>
  </span>
  <span class="footer-developer">
    <a
      href="https://github.com/jmvillanueva-dev"
      class="developer-info"
      target="_blank"
      rel="noopener noreferrer"
    >
      | Desarrollado por
      <img src="/src/icons/social-media/github.svg" alt="" width="16px" />
      <strong>{developer}</strong> |
    </a>
  </span>
  <span class="footer-location">
    <img src="/src/icons/ecuador.svg" alt="Bandera Ecuador" />
    Hecho en Ecuador
  </span>
</footer>

<style>
  .main-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    width: 100%;
    flex-shrink: 0; /* Evita que el footer se comprima */
    padding: var(--space-4, 1rem) var(--space-6, 1.5rem);
    color: var(--color-text-secondary, #475569);
    text-align: center;
    font-size: var(--font-size-sm, 0.875rem);
    background-color: transparent;
  }

  .main-footer p {
    margin: 0;
    line-height: var(--line-height-base, 1.5);
  }

  .developer-info {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1, 0.25rem);
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-fast, 0.15s ease);
  }

  .developer-info:hover {
    color: var(--color-primary, #2563eb);
  }

  .developer-info:hover strong {
    text-decoration: underline;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1, 0.25rem);
  }

  .footer-location img {
    width: 20px;
    height: auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .main-footer {
      flex-direction: column;
      gap: var(--space-2, 0.5rem);
      padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
      font-size: var(--font-size-xs, 0.75rem);
    }

    .developer-info {
      /* Remover barras separadoras en móvil */
      font-size: var(--font-size-xs, 0.75rem);
    }
  }
</style>
