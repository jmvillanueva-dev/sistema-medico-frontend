---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import MedicalEvolutionHistory from "../../../components/MedicalEvolution/MedicalEvolutionHistory";

// Get URL parameters
const url = new URL(Astro.request.url);
const historiaClinicaId = url.searchParams.get("historiaClinicaId");
---

<DashboardLayout title="Evoluciones Médicas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {
      historiaClinicaId && (
        <div class="mb-6">
          <a
            href="/medical/clinical-records"
            class="inline-flex items-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900 transition-colors"
          >
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 19l-7-7m0 0l7-7m-7 7h18"
              />
            </svg>
            Volver a Historias Clínicas
          </a>
        </div>
      )
    }
    <MedicalEvolutionHistory
      client:load
      historiaClinicaId={historiaClinicaId || undefined}
    />
  </div>
</DashboardLayout>
