---
import UserDropdown from "@/components/UserDropdown.tsx";
import { ModuleSwitcher } from "@/components/ui/ModuleSwitcher";

const userCookie = Astro.cookies.get("auth-user")?.value;
let user = null;
if (userCookie) {
  try {
    user = JSON.parse(userCookie);
  } catch (e) {
    user = null;
  }
}
const userName = user ? `${user.name} ${user.lastName}` : "Usuario";
const userEmail = user?.email || "";
---

<header
  id="dashboard-header"
  class="w-full py-3 sticky top-0 z-[1000] shrink-0 transition-all duration-300 border-b border-slate-200"
>
  <div
    id="header-content"
    class="max-w-7xl mx-auto px-6 py-2 flex justify-between items-center transition-all duration-300"
  >
    <div class="flex items-center gap-6">
      <a href="/admin/dashboard" class="flex items-center">
        <img
          src="/logo-cm-ue.svg"
          alt="Logo Centro Médico Urdiales-Espinoza"
          height="32"
          class="block h-8 w-auto"
        />
      </a>

      <div class="hidden md:block">
        <ModuleSwitcher client:load roles={user?.roles} />
      </div>
    </div>

    <div class="flex items-center gap-4">
      <div class="flex flex-col text-right justify-center hidden md:flex">
        <span class="font-semibold text-sm text-slate-900 leading-tight"
          >{userName}</span
        >
        <span class="text-xs text-slate-500 leading-tight">{userEmail}</span>
      </div>
      <UserDropdown client:load roles={user?.roles} />
    </div>
  </div>
</header>

<script>
  // Script para manejar el scroll del header
  const header = document.getElementById("dashboard-header");
  const headerContent = document.getElementById("header-content");

  function updateHeader() {
    if (window.scrollY > 20) {
      // Cuando se hace scroll
      header?.classList.add("bg-white/95", "backdrop-blur-sm");
      headerContent?.classList.add("bg-white", "rounded-full");
    } else {
      // En la parte superior (transparente)
      header?.classList.remove("bg-white/95", "backdrop-blur-sm");
      headerContent?.classList.remove("bg-white", "rounded-full");
    }
  }

  // Ejecutar al cargar y al hacer scroll
  updateHeader();
  window.addEventListener("scroll", updateHeader);
</script>
