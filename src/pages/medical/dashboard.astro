---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import DailyEvolutionReport from "@/components/DailyEvolutionReport";
---

<DashboardLayout title="Dashboard Médico" role="medical">
  <div class="flex flex-col gap-6">
    <div class="bg-blue-50 border border-blue-100 rounded-xl p-6">
      <h1 class="text-2xl font-bold text-slate-900 mb-2">Panel Médico</h1>
      <p class="text-slate-600">
        Resumen diario de evoluciones médicas registradas en el sistema
      </p>
    </div>

    <DailyEvolutionReport client:load />
  </div>
</DashboardLayout>
