---
import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import MedicalEvolutionForm from "../../../../components/MedicalEvolution/MedicalEvolutionForm";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/medical/patients");
}

const userCookie = Astro.cookies.get("auth-user")?.value;
let employeeId = "";

if (userCookie) {
  try {
    const user = JSON.parse(userCookie);
    employeeId = user.employeeId;
  } catch (e) {
    console.error("Error parsing auth-user cookie", e);
  }
}

if (!employeeId) {
  // If no employee ID, maybe redirect to login or show error
  // For now, we assume middleware handles auth, but we need the ID for the form
  console.warn("No employee ID found in cookie");
}
---

<DashboardLayout title="Nueva Evolución Médica">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 h-[calc(100vh-64px)]">
    <MedicalEvolutionForm
      client:load
      historiaClinicaId={id}
      empleadoId={employeeId}
      onSuccess={() => {
        window.location.href = `/medical/evolutions/history/${id}`;
      }}
      onCancel={() => {
        window.history.back();
      }}
    />
  </div>
</DashboardLayout>
